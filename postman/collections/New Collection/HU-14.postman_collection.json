{
  "info": {
    "name": "Sprint 2 - HU-14",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ajusta las variables de la colección: fecha (futura, de un día con horario de HU-09), idEspecialista, idUsuario, idCita (cita pendiente de ese usuario) e idBloqueo."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "fecha",
      "value": "2026-10-19"
    },
    {
      "key": "idEspecialista",
      "value": "1"
    },
    {
      "key": "idUsuario",
      "value": "2"
    },
    {
      "key": "idCita",
      "value": "1"
    },
    {
      "key": "idBloqueo",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Cancelar cita (200)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/citas/{{idCita}}/cancelar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "citas",
            "{{idCita}}",
            "cancelar"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idUsuario\": \"{{idUsuario}}\",\n  \"motivo\": \"Tengo un imprevisto\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Cancelar de nuevo (400)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/citas/{{idCita}}/cancelar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "citas",
            "{{idCita}}",
            "cancelar"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idUsuario\": \"{{idUsuario}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Cita de otro usuario (400)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/citas/{{idCita}}/cancelar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "citas",
            "{{idCita}}",
            "cancelar"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idUsuario\": 9999\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Falta idUsuario (400)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/citas/{{idCita}}/cancelar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "citas",
            "{{idCita}}",
            "cancelar"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Cita inexistente (404)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/citas/9999/cancelar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "citas",
            "9999",
            "cancelar"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idUsuario\": \"{{idUsuario}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}